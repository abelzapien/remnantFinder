<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseAppHost>true</UseAppHost>
    <AssemblyName>BuildLootOverseer.Backend</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <ApplicationIcon>Assets\overseer-icon.ico</ApplicationIcon>
    <Product>Remnant 2 Build &amp; Loot Overseer</Product>
    <AssemblyTitle>Remnant 2 Build &amp; Loot Overseer</AssemblyTitle>
    <Description>Remnant 2 Build &amp; Loot Overseer — Real-Time Build Synergy &amp; Safe Save Loot Tracker</Description>
    <Authors>Choppx</Authors>
    <Company>Choppx</Company>
    <Copyright>Copyright (C) 2026 Choppx · Open Source (GNU GPL-3.0)</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\overseer-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\overseer-icon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="lib.remnant2.analyzer" Version="2.0.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
